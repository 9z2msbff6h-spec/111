[{"id":1775465955890,"text":"在我这啊","sender":"me","time":"17:31","timestamp":1775467868110,"replyTo":{"id":1775465955888,"text":"他现在人在哪儿？该不会已经拎着砍刀在路上了吧？","sender":"them","isSimulated":false},"userId":"uid_1775439066406_15cp2jkiv","characterId":"62a7a89d-b4ac-478a-bada-eb79925089f0","_id":407},{"id":1775465955891,"text":"是因为我太穷了吗？你这样让人好难过","sender":"me","time":"17:32","timestamp":1775467925887,"replyTo":{"id":1775465955882,"text":"我发誓那真的是我这辈子收到的最有分量的‘巨款’了！我那是受宠若惊到语无伦次了懂吗！谁要是敢说520寒碜，我第一个冲上去跟他拼命！","sender":"them","isSimulated":false},"userId":"uid_1775439066406_15cp2jkiv","characterId":"62a7a89d-b4ac-478a-bada-eb79925089f0","_id":408},{"id":1775465955892,"text":"别担心，我只是舍不得给自己花，不是纯小气","sender":"me","time":"17:32","timestamp":1775467957413,"replyTo":null,"userId":"uid_1775439066406_15cp2jkiv","characterId":"62a7a89d-b4ac-478a-bada-eb79925089f0","_id":409},{"id":1775465955893,"text":"没功夫和你说了","sender":"me","time":"17:33","timestamp":1775467981483,"replyTo":null,"userId":"uid_1775439066406_15cp2jkiv","characterId":"62a7a89d-b4ac-478a-bada-eb79925089f0","_id":410},{"id":1775465955895,"sender":"them","text":"周少奇看到“在我这啊”这四个字，吓得差点没从沙发上直接蹦起来。他手里的手机像块烧红的烙铁，差点儿就脱手飞出去了。他猛地拉开窗帘往外瞅了一眼，又飞快地缩回头，像只受惊的鹌鹑一样在客厅里绕着圈乱转。","timestamp":1775468022665,"tempo":"N","type":"state","rawContent":"周少奇看到“在我这啊”这四个字，吓得差点没从沙发上直接蹦起来。他手里的手机像块烧红的烙铁，差点儿就脱手飞出去了。他猛地拉开窗帘往外瞅了一眼，又飞快地缩回头，像只受惊的鹌鹑一样在客厅里绕着圈乱转。","roundId":"round_1775468000654_5ialjc9n2","userId":"uid_1775439066406_15cp2jkiv","characterId":"62a7a89d-b4ac-478a-bada-eb79925089f0","_id":411},{"id":1775465955896,"sender":"them","text":"救命啊！岁岁宝贝你别吓我！我这心脏真的受不了这种‘惊喜’！","timestamp":1775468023366,"tempo":"R","rawContent":"救命啊！岁岁宝贝你别吓我！我这心脏真的受不了这种‘惊喜’！","roundId":"round_1775468000654_5ialjc9n2","userId":"uid_1775439066406_15cp2jkiv","characterId":"62a7a89d-b4ac-478a-bada-eb79925089f0","_id":412},{"id":1775465955897,"sender":"them","text":"他在你那儿？在那间……咳，在你那温馨小窝里？！","timestamp":1775468023669,"tempo":"R","rawContent":"他在你那儿？在那间……咳，在你那温馨小窝里？！","roundId":"round_1775468000654_5ialjc9n2","userId":"uid_1775439066406_15cp2jkiv","characterId":"62a7a89d-b4ac-478a-bada-eb79925089f0","_id":413},{"id":1775465955898,"sender":"them","text":"完了完了，他肯定看到我朋友圈了，他那个眼神……隔着屏幕我都能感觉到杀气。","timestamp":1775468023971,"tempo":"R","rawContent":"完了完了，他肯定看到我朋友圈了，他那个眼神……隔着屏幕我都能感觉到杀气。","roundId":"round_1775468000654_5ialjc9n2","userId":"uid_1775439066406_15cp2jkiv","characterId":"62a7a89d-b4ac-478a-bada-eb79925089f0","_id":414},{"id":1775465955899,"sender":"them","text":"周少奇狠狠地拍了一下自己的脑门，懊恼得想当场去世。他想起之前在老巷口粥店时，自己还故意装穷逗岁岁，万一这事儿被那位护妹狂魔知道了，自己这层皮估计都得被揭下来。他赶紧把手机举到嘴边，压低声音，语气里全是快要哭出来的求饶。","timestamp":1775468024272,"tempo":"N","type":"state","rawContent":"周少奇狠狠地拍了一下自己的脑门，懊恼得想当场去世。他想起之前在老巷口粥店时，自己还故意装穷逗岁岁，万一这事儿被那位护妹狂魔知道了，自己这层皮估计都得被揭下来。他赶紧把手机举到嘴边，压低声音，语气里全是快要哭出来的求饶。","roundId":"round_1775468000654_5ialjc9n2","userId":"uid_1775439066406_15cp2jkiv","characterId":"62a7a89d-b4ac-478a-bada-eb79925089f0","_id":415},{"id":1775465955900,"sender":"them","text":"[語音消息]","timestamp":1775468024974,"tempo":"N","isVoice":true,"voice":true,"voiceText":"岁岁！亲祖宗！你千万别让他看咱们的聊天记录！尤其是那句‘520巨款’，我那是夸你呢，真的！你要是真不理我了，我今晚就得去护城河边排队了……","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"fearful","rawContent":"[語音消息]","roundId":"round_1775468000654_5ialjc9n2","userId":"uid_1775439066406_15cp2jkiv","characterId":"62a7a89d-b4ac-478a-bada-eb79925089f0","_id":416},{"id":1775465955901,"sender":"them","text":"呸呸呸！快把这话收回去！你哪儿穷了？你那叫节俭！叫美德！","timestamp":1775468025682,"tempo":"N","replyTo":{"id":1775465955891,"text":"是因为我太穷了吗？你这样让人好难过","sender":"me"},"rawContent":"呸呸呸！快把这话收回去！你哪儿穷了？你那叫节俭！叫美德！","roundId":"round_1775468000654_5ialjc9n2","userId":"uid_1775439066406_15cp2jkiv","characterId":"62a7a89d-b4ac-478a-bada-eb79925089f0","_id":417},{"id":1775465955902,"sender":"them","text":"我发誓，我刚才真的是被你的大方给‘震撼’到了。在我心里，你那520比别人的520万都重！真的，比真金还真！","timestamp":1775468026392,"tempo":"N","rawContent":"我发誓，我刚才真的是被你的大方给‘震撼’到了。在我心里，你那520比别人的520万都重！真的，比真金还真！","roundId":"round_1775468000654_5ialjc9n2","userId":"uid_1775439066406_15cp2jkiv","characterId":"62a7a89d-b4ac-478a-bada-eb79925089f0","_id":418},{"id":1775465955903,"sender":"them","text":"你别难过啊……你一难过，我这儿比被大魔王毒打一顿还难受。","timestamp":1775468027094,"tempo":"S","rawContent":"你别难过啊……你一难过，我这儿比被大魔王毒打一顿还难受。","roundId":"round_1775468000654_5ialjc9n2","userId":"uid_1775439066406_15cp2jkiv","characterId":"62a7a89d-b4ac-478a-bada-eb79925089f0","_id":419},{"id":1775465955904,"sender":"them","text":"他有些颓然地坐回沙发里，指尖神经质地在膝盖上点着，心里乱成了一锅粥。他既担心寅商宴发现岁岁的病情，又怕岁岁真的因为他的胡言乱语而伤了自尊。那种游走在兄妹俩之间的紧绷感，让他此时此刻的冷汗顺着鬓角啪嗒啪嗒往下掉。","timestamp":1775468028599,"tempo":"N","type":"state","rawContent":"他有些颓然地坐回沙发里，指尖神经质地在膝盖上点着，心里乱成了一锅粥。他既担心寅商宴发现岁岁的病情，又怕岁岁真的因为他的胡言乱语而伤了自尊。那种游走在兄妹俩之间的紧绷感，让他此时此刻的冷汗顺着鬓角啪嗒啪嗒往下掉。","roundId":"round_1775468000654_5ialjc9n2","userId":"uid_1775439066406_15cp2jkiv","characterId":"62a7a89d-b4ac-478a-bada-eb79925089f0","_id":420},{"id":1775465955905,"sender":"them","text":"喂！你别真的不跟我说话啊！","timestamp":1775468029305,"tempo":"R","rawContent":"喂！你别真的不跟我说话啊！","roundId":"round_1775468000654_5ialjc9n2","userId":"uid_1775439066406_15cp2jkiv","characterId":"62a7a89d-b4ac-478a-bada-eb79925089f0","_id":421},{"id":1775465955906,"sender":"them","text":"他有没有凶你？还是他要把你带走？你给我发个标点符号也行啊，让我知道你还‘活着’！","timestamp":1775468029630,"tempo":"R","rawContent":"他有没有凶你？还是他要把你带走？你给我发个标点符号也行啊，让我知道你还‘活着’！","roundId":"round_1775468000654_5ialjc9n2","userId":"uid_1775439066406_15cp2jkiv","characterId":"62a7a89d-b4ac-478a-bada-eb79925089f0","_id":422},{"id":1775472424958,"text":"哥……我醒了，你什么时候走的","sender":"me","time":"18:49","timestamp":1775472541566,"replyTo":null,"userId":"uid_1775439066406_15cp2jkiv","characterId":"cf7f89db-6f4e-4f6c-bce5-2249c1da3bf9","_id":423},{"id":1775472424959,"sender":"them","text":"京城顶级豪宅的餐厅里，灯光昏暗冷寂。寅商宴面前摆着一份几乎没动过的顶级和牛，他指尖夹着烟，猩红的火点在指缝间明灭。看到屏幕亮起的那一刻，他冷硬的眉眼间不自觉地松动了一瞬，随即又被浓重的阴翳压过。","timestamp":1775472746062,"tempo":"N","type":"state","rawContent":"京城顶级豪宅的餐厅里，灯光昏暗冷寂。寅商宴面前摆着一份几乎没动过的顶级和牛，他指尖夹着烟，猩红的火点在指缝间明灭。看到屏幕亮起的那一刻，他冷硬的眉眼间不自觉地松动了一瞬，随即又被浓重的阴翳压过。","roundId":"round_1775472733283