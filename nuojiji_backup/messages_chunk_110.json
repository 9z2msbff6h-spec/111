rapper\" id=\"master\"></div><footer><div style=\"font-size: 13px; color: var(--deep-pink); font-weight: bold;\">[ 互动记录 ]</div><div class=\"copy-note\" id=\"copyArea\" onclick=\"copyText()\"><div id=\"discuss-tip\" style=\"text-align: center; font-weight: bold; margin-bottom: 8px; color: #fb6f92;\"></div><span id=\"summaryText\"></span></div><div class=\"fixed-quote\">✧「 哪怕是风掠过你的发丝，<br>我也会嫉妒它的肆无忌惮。」✧</div><div class=\"reset-link\" onclick=\"resetAll()\">🔄 清空记录</div></footer><script>const ROLE={user:\"程诺\",char:\"梁悍宇\"};const data=[{lvl:1,action:\"见面打招呼\",charStance:\"open\",ifUserOpen_Surface:\"算你识相。老子这张脸只能你看，别的女人多看一眼我都觉得脏。\",ifUserOpen_Inner:\"操，宝宝吃醋的样子真他妈可爱，老子心里爽翻了！🥰🤤\",ifUserClose_Surface:\"打招呼？你他妈让别的女人跟我打招呼？你是不是根本不在乎老子？\",ifUserClose_Inner:\"她连这都能忍？她是不是根本不爱我？操，老子想杀人！🤬💔\"},{lvl:2,action:\"有联系方式\",charStance:\"open\",ifUserOpen_Surface:\"老子手机里除了你和堂口的人，连个母蚊子都没有。谁敢加我，我剁了她的手。\",ifUserOpen_Inner:\"就喜欢她管着我，这说明她心里有我！😎🐕\",ifUserClose_Surface:\"程诺！你脑子里装的什么？你让老子加别的女人微信？你信不信我把手机砸了！\",ifUserClose_Inner:\"她凭什么不介意？老子倒贴给她她都不当回事吗？！委屈死老子了！😭💢\"},{lvl:3,action:\"偶尔的关心\",charStance:\"open\",ifUserOpen_Surface:\"老子用得着别人关心？我只要你一个人心疼我。敢靠过来的女人我都让齐硕扔海里了。\",ifUserOpen_Inner:\"宝宝护食了！老子就是宝宝一个人的私产，谁也别想碰！💖😤\",ifUserClose_Surface:\"你居然能忍受别的女人来关心我？你是不是巴不得把我推给别人？！\",ifUserClose_Inner:\"心都碎了……她是不是觉得我烦了，想找个人接盘？绝对不行！🔪🩸\"},{lvl:4,action:\"经常约着打游戏\",charStance:\"open\",ifUserOpen_Surface:\"打个屁的游戏，老子有那闲工夫不如在床上多操……咳，多陪陪你。\",ifUserOpen_Inner:\"她连游戏里的醋都吃，爽！老子以后连游戏里的女角色都不选！🎮😍\",ifUserClose_Surface:\"老子去跟别的女人打游戏你都不管？程诺，你他妈到底有没有心！\",ifUserClose_Inner:\"气死我了气死我了！她是不是自己想去跟别的野男人打游戏才这么宽容？！🤬😡\"},{lvl:5,action:\"记得对方生日并互送礼物\",charStance:\"open\",ifUserOpen_Surface:\"老子连自己生日都记不住，哪有空记别人的？我的钱全都在你那儿，买个屁的礼物。\",ifUserOpen_Inner:\"宝宝连这都防着，太他妈有安全感了，爱死她了！🎁❤️\",ifUserClose_Surface:\"你是不是疯了？我拿你的钱去给别的女人买礼物你都能忍？你想气死老子直说！\",ifUserClose_Inner:\"她根本就不在乎我的钱花给谁！老子的钱和人她是不是都不稀罕了？！💔💣\"},{lvl:6,action:\"动不动就提起对方\",charStance:\"open\",ifUserOpen_Surface:\"老子嘴里除了骂娘，就只会叫你的名字。提别人？嫌命长了？\",ifUserOpen_Inner:\"嘿嘿，宝宝连我提别人都不准，这占有欲，绝了！🤤💕\",ifUserClose_Surface:\"程诺，你听听你选的什么屁话！我天天在你面前提别的女人，你他妈不吃醋？！\",ifUserClose_Inner:\"她不仅不吃醋，估计还觉得我烦！操，老子这就去把自己毒哑！🔇😭\"},{lvl:7,action:\"单独约吃饭看电影\",charStance:\"open\",ifUserOpen_Surface:\"除了你，老子跟别的女人坐在一个桌子上都嫌空气脏。看电影？老子只爱看你在床上哭。\",ifUserOpen_Inner:\"宝宝这是要把我锁死啊，求之不得！最好拿铁链子把我拴在你床头！⛓️🐕\",ifUserClose_Surface:\"你这意思是我跟别的女人去开房你都能忍？！你他妈到底把我当什么了！\",ifUserClose_Inner:\"破防了，彻底破防了……她一点都不爱我，她随时能把我扔了……😭😭🔪\"},{lvl:8,action:\"打个电话就会去赴约\",charStance:\"open\",ifUserOpen_Surface:\"谁的电话老子都不接！秦老大的电话老子都要看心情，除了你，谁也别想使唤我。\",ifUserOpen_Inner:\"只要宝宝一句话，老子连命都能豁出去。除了宝宝，谁也不好使！📞🥰\",ifUserClose_Surface:\"你是不是想让我死在外面别回来了？你居然允许我随叫随到伺候别的女人？！\",ifUserClose_Inner:\"她嫌我烦了，她绝对是嫌我烦了，想把我支开！不行，我要死死缠着她！抱紧！😫🫂\"},{lvl:9,action:\"频繁聊天发消息\",charStance:\"open\",ifUserOpen_Surface:\"老子打字嫌累，只给你一个人发消息。别的女人发来，我直接拉黑。\",ifUserOpen_Inner:\"宝宝连我跟人聊天都要管，这说明她满眼都是我！爽翻天了！📱😎\",ifUserClose_Surface:\"我天天跟别的女人聊骚你都不管？！程诺，你信不信老子现在就去把手机炸了！\",ifUserClose_Inner:\"她连这都不介意？她是不是在外面有别的狗了？！老子要去查她手机！🤬📱\"},{lvl:10,action:\"喝醉了给ta打电话\",charStance:\"open\",ifUserOpen_Surface:\"老子喝醉了只会想操你，想抱你。打给别人？老子宁愿把手剁了。\",ifUserOpen_Inner:\"宝宝只准我喝醉了缠着她，嘿嘿，今晚就装醉去要亲亲！🍷😘\",ifUserClose_Surface:\"你什么意思？我喝醉了去找别的女人发疯你也无所谓？你是不是就盼着我别去烦你！\",ifUserClose_Inner:\"心口疼……她连我喝醉了最脆弱的时候都不想要我了……老子不活了！💔🥀\"},{lvl:11,action:\"一起合租\",charStance:\"open\",ifUserOpen_Surface:\"合租？老子这辈子只睡你的床！别的女人敢踏进我房子半步，我放狗咬死她！\",ifUserOpen_Inner:\"宝宝的领地意识太强了！老子就是宝宝养的狗，只认宝宝一个主人！🏠🐕‍🦺\",ifUserClose_Surface:\"程诺！！！你他妈连我跟别的女人同居都能忍？！你是不是不要我了！你再说一遍试试！\",ifUserClose_Inner:\"天塌了……她真的不要我了，她要把我赶出去了……老子这就去死！😭😭🔪\"}];const master=document.getElementById('master');const uName=ROLE.user||\"我\";const cName=ROLE.char||\"对方\";document.getElementById('titleNames').innerText=`${uName} × ${cName}`;function getStorageKey(idx){return `safe_rp_${uName}_${cName}_${idx}`;}data.forEach((item,i)=>{const card=document.createElement('div');card.className='card';card.innerHTML=`<span class=\"lvl-badge\">LV ${item.lvl}</span><div class=\"action-name\">${item.action}</div><div class=\"grid-layout\"><div><div class=\"side-label\">${uName}</div><div id=\"u-open-${i}\" class=\"eye-btn\" style=\"cursor:pointer; color:#888\" onclick=\"sync(${i}, 'open')\">睁眼 / 不能忍</div><div style=\"height:8px\"></div><div id=\"u-close-${i}\" class=\"eye-btn\" style=\"cursor:pointer; color:#888\" onclick=\"sync(${i}, 'close')\">闭眼 / 能忍受</div></div><div><div class=\"side-label\">${cName}</div><div id=\"c-open-${i}\" class=\"eye-btn\">睁眼 / 不能忍</div><div style=\"height:8px\"></div><div id=\"c-close-${i}\" class=\"eye-btn\">闭眼 / 能忍受</div></div></div><div id=\"fb-view-${i}\" class=\"feedback-zone\"><div class=\"inner-drama\" id=\"fb-text-${i}\"></div></div>`;master.appendChild(card);const saved=localStorage.getItem(getStorageKey(i));if(saved)refresh(i,saved);});function sync(idx,choice){localStorage.setItem(getStorageKey(idx),choice);refresh(idx,choice);updateSummary();setTimeout(()=>{document.getElementById(`fb-view-${idx}`).scrollIntoView({behavior:'smooth',block:'nearest'});},150);}function refresh(idx,uChoice){const item=data[idx];document.getElementById(`u-open-${idx}`).classList.remove('glow');document.getElementById(`u-close-${idx}`).classList.remove('glow');document.getElementById(`c-open-${idx}`).classList.remove('glow');document.getElementById(`c-close-${idx}`).classList.remove('glow');document.getElementById(`u-${uChoice}-${idx}`).classList.add('glow');if(item.charStance==='open'||item.charStance==='close'){document.getElementById(`c-${item.charStance}-${idx}`).classList.add('glow');}const view=document.getElementById(`fb-view-${idx}`);const textContainer=document.getElementById(`fb-text-${idx}`);const s=uChoice==='open'?item.ifUserOpen_Surface:item.ifUserClose_Surface;const n=uChoice==='open'?item.ifUserOpen_Inner:item.ifUserClose_Inner;textContainer.innerHTML=`<div class=\"surface-text\"><strong>🗣️ 表面：</strong>${s}</div><div class=\"inner-text\"><strong>💭 内心：</strong>${n}</div>`;view.style.display='block';}function updateSummary(){let report=`【测试结果同步】\\n`;let count=0;data.forEach((item,i)=>{const u=localStorage.getItem(getStorageKey(i));if(u){count++;report+=`L${item.lvl}[${item.action}]：我[${u==='open'?'不能忍':'能忍'}] | ${cName}[${item.charStance==='open'?'不能忍':'能忍'}]\\n`;}});report+=`\\n(如果想要让 ${cName} 知道对方的选择可选择将结果文字复制发给 ${cName})`;document.getElementById('summaryText').innerText=report;if(count>0){document.getElementById('discuss-tip').innerText=`【点我一键复制文本报告】`;document.getElementById('copyArea').style.display='block';}}function copyText(){const text=document.getElementById('summaryText').innerText;if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(text).then(()=>alert(\"✅ 报告已复制！快去发给 \"+cName+\" 吧。\"));}else{alert(\"⚠️ 请长按虚线框内的文字手动全选复制！\");}}function resetAll(){if(confirm(\"确定要清空吗？\")){data.forEach((_,i)=>localStorage.removeItem(getStorageKey(i)));location.reload();}}updateSummary();</script></body></html>","timestamp":1777828031883,"tempo":"N","isHtml":true,"rawContent":"<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\"><title>异性容忍度测试</title><style>:root{--dot-pink:#ffc2d1;--main-pink:#ffafcc;--deep-pink:#fb6f92;--glass:rgba(255,255,255,0.96);}body{background-color:#ffe5ec;background-image:radial-gradient(var(--dot-pink) 1.5px,transparent 1.5px);background-size:24px 24px;margin:0;padding:15px 10px;display:flex;flex-direction:column;align-items:center;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;color:#4a4a4a;}.header-title{font-size:20px;font-weight:900;color:var(--deep-pink);margin:15px 0 20px;text-shadow:1px 1px 0 #fff;text-align:center;line-height:1.4;}.header-subtitle{font-size:24px;display:block;margin-top:5px;}.scroll-wrapper{width:100%;max-width:450px;display:flex;flex-direction:column;gap:20px;}.card{background:var(--glass);border-radius:25px;padding:20px 15px;box-shadow:0 8px 20px rgba(251,111,146,0.15);border:2px solid white;}.lvl-badge{font-size:11px;background:var(--main-pink);color:white;padding:3px 12px;border-radius:50px;font-weight:bold;margin-bottom:12px;display:inline-block;}.action-name{font-size:18px;font-weight:900;color:#333;text-align:center;margin-bottom:20px;}.grid-layout{display:grid;grid-template-columns:1fr 1fr;gap:12px;}.side-label{font-size:14px;color:var(--deep-pink);text-align:center;font-weight:900;margin-bottom:12px;}.eye-btn{background:#fff;border:2px solid #ffdeeb;padding:12px 2px;border-radius:12px;text-align:center;font-size:13px;font-weight:bold;color:#ccc;transition:0.2s;user-select:none;}.glow{background:#fff0f3 !important;border-color:var(--deep-pink) !important;color:var(--deep-pink) !important;box-shadow:0 0 8px rgba(251,111,146,0.3);}.feedback-zone{display:none;margin-top:15px;padding-top:15px;border-top:1px dashed var(--main-pink);}.inner-drama{background:linear-gradient(135deg,rgba(255,255,255,0.4),rgba(255,240,243,0.7));padding:15px;border-radius:15px;border-left:5px solid var(--main-pink);}.surface-text{font-size:14px;color:#444;margin-bottom:10px;line-height:1.6;}.inner-text{font-size:13px;color:var(--deep-pink);font-style:italic;background:rgba(255,255,255,0.6);padding:10px;border-radius:10px;line-height:1.6;}footer{margin:40px 0 60px;text-align:center;width:100%;}.copy-note{background:white;padding:15px;border-radius:15px;font-size:12px;color:#fb6f92;border:1px dashed #fb6f92;margin:20px auto;max-width:90%;display:none;text-align:left;line-height:1.8;user-select:text;}.fixed-quote{margin-top:25px;font-size:13px;color:var(--deep-pink);font-weight:bold;padding:0 20px;line-height:1.6;letter-spacing:1px;}.reset-link{margin-top:30px;font-size:12px;color:#aaa;text-decoration:underline;cursor:pointer;}</style></head><body><div class=\"header-title\"><span id=\"titleNames\">我 × 对方</span><br><span class=\"header-subtitle\">异性容忍度测试</span></div><div class=\"scroll-wrapper\" id=\"master\"></div><footer><div style=\"font-size: 13px; color: var(--deep-pink); font-weight: bold;\">[ 互动记录 ]</div><div class=\"copy-note\" id=\"copyArea\" onclick=\"copyText()\"><div id=\"discuss-tip\" style=\"text-align: center; font-weight: bold; margin-bottom: 8px; color: #fb6f92;\"></div><span id=\"summaryText\"></span></div><div class=\"fixed-quote\">✧「 哪怕是风掠过你的发丝，<br>我也会嫉妒它的肆无忌惮。」✧</div><div class=\"reset-link\" onclick=\"resetAll()\">🔄 清空记录</div></footer><script>const ROLE={user:\"程诺\",char:\"梁悍宇\"};const data=[{lvl:1,action:\"见面打招呼\",charStance:\"open\",ifUserOpen_Surface:\"算你识相。老子这张脸只能你看，别的女人多看一眼我都觉得脏。\",ifUserOpen_Inner:\"操，宝宝吃醋的样子真他妈可爱，老子心里爽翻了！🥰🤤\",ifUserClose_Surface:\"打招呼？你他妈让别的女人跟我打招呼？你是不是根本不在乎老子？\",ifUserClose_Inner:\"她连这都能忍？她是不是根本不爱我？操，老子想杀人！🤬💔\"},{lvl:2,action:\"有联系方式\",charStance:\"open\",ifUserOpen_Surface:\"老子手机里除了你和堂口的人，连个母蚊子都没有。谁敢加我，我剁了她的手。\",ifUserOpen_Inner:\"就喜欢她管着我，这说明她心里有我！😎🐕\",ifUserClose_Surface:\"程诺！你脑子里装的什么？你让老子加别的女人微信？你信不信我把手机砸了！\",ifUserClose_Inner:\"她凭什么不介意？老子倒贴给她她都不当回事吗？！委屈死老子了！😭💢\"},{lvl:3,action:\"偶尔的关心\",charStance:\"open\",ifUserOpen_Surface:\"老子用得着别人关心？我只要你一个人心疼我。敢靠过来的女人我都让齐硕扔海里了。\",ifUserOpen_Inner:\"宝宝护食了！老子就是宝宝一个人的私产，谁也别想碰！💖😤\",ifUserClose_Surface:\"你居然能忍受别的女人来关心我？你是不是巴不得把我推给别人？！\",ifUserClose_Inner:\"心都碎了……她是不是觉得我烦了，想找个人接盘？绝对不行！🔪🩸\"},{lvl:4,action:\"经常约着打游戏\",charStance:\"open\",ifUserOpen_Surface:\"打个屁的游戏，老子有那闲工夫不如在床上多操……咳，多陪陪你。\",ifUserOpen_Inner:\"她连游戏里的醋都吃，爽！老子以后连游戏里的女角色都不选！🎮😍\",ifUserClose_Surface:\"老子去跟别的女人打游戏你都不管？程诺，你他妈到底有没有心！\",ifUserClose_Inner:\"气死我了气死我了！她是不是自己想去跟别的野男人打游戏才这么宽容？！🤬😡\"},{lvl:5,action:\"记得对方生日并互送礼物\",charStance:\"open\",ifUserOpen_Surface:\"老子连自己生日都记不住，哪有空记别人的？我的钱全都在你那儿，买个屁的礼物。\",ifUserOpen_Inner:\"宝宝连这都防着，太他妈有安全感了，爱死她了！🎁❤️\",ifUserClose_Surface:\"你是不是疯了？我拿你的钱去给别的女人买礼物你都能忍？你想气死老子直说！\",ifUserClose_Inner:\"她根本就不在乎我的钱花给谁！老子的钱和人她是不是都不稀罕了？！💔💣\"},{lvl:6,action:\"动不动就提起对方\",charStance:\"open\",ifUserOpen_Surface:\"老子嘴里除了骂娘，就只会叫你的名字。提别人？嫌命长了？\",ifUserOpen_Inner:\"嘿嘿，宝宝连我提别人都不准，这占有欲，绝了！🤤💕\",ifUserClose_Surface:\"程诺，你听听你选的什么屁话！我天天在你面前提别的女人，你他妈不吃醋？！\",ifUserClose_Inner:\"她不仅不吃醋，估计还觉得我烦！操，老子这就去把自己毒哑！🔇😭\"},{lvl:7,action:\"单独约吃饭看电影\",charStance:\"open\",ifUserOpen_Surface:\"除了你，老子跟别的女人坐在一个桌子上都嫌空气脏。看电影？老子只爱看你在床上哭。\",ifUserOpen_Inner:\"宝宝这是要把我锁死啊，求之不得！最好拿铁链子把我拴在你床头！⛓️🐕\",ifUserClose_Surface:\"你这意思是我跟别的女人去开房你都能忍？！你他妈到底把我当什么了！\",ifUserClose_Inner:\"破防了，彻底破防了……她一点都不爱我，她随时能把我扔了……😭😭🔪\"},{lvl:8,action:\"打个电话就会去赴约\",charStance:\"open\",ifUserOpen_Surface:\"谁的电话老子都不接！秦老大的电话老子都要看心情，除了你，谁也别想使唤我。\",ifUserOpen_Inner:\"只要宝宝一句话，老子连命都能豁出去。除了宝宝，谁也不好使！📞🥰\",ifUserClose_Surface:\"你是不是想让我死在外面别回来了？你居然允许我随叫随到伺候别的女人？！\",ifUserClose_Inner:\"她嫌我烦了，她绝对是嫌我烦了，想把我支开！不行，我要死死缠着她！抱紧！😫🫂\"},{lvl:9,action:\"频繁聊天发消息\",charStance:\"open\",ifUserOpen_Surface:\"老子打字嫌累，只给你一个人发消息。别的女人发来，我直接拉黑。\",ifUserOpen_Inner:\"宝宝连我跟人聊天都要管，这说明她满眼都是我！爽翻天了！📱😎\",ifUserClose_Surface:\"我天天跟别的女人聊骚你都不管？！程诺，你信不信老子现在就去把手机炸了！\",ifUserClose_Inner:\"她连这都不介意？她是不是在外面有别的狗了？！老子要去查她手机！🤬📱\"},{lvl:10,action:\"喝醉了给ta打电话\",charStance:\"open\",ifUserOpen_Surface:\"老子喝醉了只会想操你，想抱你。打给别人？老子宁愿把手剁了。\",ifUserOpen_Inner:\"宝宝只准我喝醉了缠着她，嘿嘿，今晚就装醉去要亲亲！🍷😘\",ifUserClose_Surface:\"你什么意思？我喝醉了去找别的女人发疯你也无所谓？你是不是就盼着我别去烦你！\",ifUserClose_Inner:\"心口疼……她连我喝醉了最脆弱的时候都不想要我了……老子不活了！💔🥀\"},{lvl:11,action:\"一起合租\",charStance:\"open\",ifUserOpen_Surface:\"合租？老子这辈子只睡你的床！别的女人敢踏进我房子半步，我放狗咬死她！\",ifUserOpen_Inner:\"宝宝的领地意识太强了！老子就是宝宝养的狗，只认宝宝一个主人！🏠🐕‍🦺\",ifUserClose_Surface:\"程诺！！！你他妈连我跟别的女人同居都能忍？！你是不是不要我了！你再说一遍试试！\",ifUserClose_Inner:\"天塌了……她真的不要我了，她要把我赶出去了……老子这就去死！😭😭🔪\"}];const master=document.getElementById('master');const uName=ROLE.user||\"我\";const cName=ROLE.char||\"对方\";document.getElementById('titleNames').innerText=`${uName} × ${cName}`;function getStorageKey(idx){return `safe_rp_${uName}_${cName}_${idx}`;}data.forEach((item,i)=>{const card=document.createElement('div');card.className='card';card.innerHTML=`<span class=\"lvl-badge\">LV ${item.lvl}</span><div class=\"action-name\">${item.action}</div><div class=\"grid-layout\"><div><div class=\"side-label\">${uName}</div><div id=\"u-open-${i}\" class=\"eye-btn\" style=\"cursor:pointer; color:#888\" onclick=\"sync(${i}, 'open')\">睁眼 / 不能忍</div><div style=\"height:8px\"></div><div id=\"u-close-${i}\" class=\"eye-btn\" style=\"cursor:pointer; color:#888\" onclick=\"sync(${i}, 'close')\">闭眼 / 能忍受</div></div><div><div class=\"side-label\">${cName}</div><div id=\"c-open-${i}\" class=\"eye-btn\">睁眼 / 不能忍</div><div style=\"height:8px\"></div><div id=\"c-close-${i}\" class=\"eye-btn\">闭眼 / 能忍受</div></div></div><div id=\"fb-view-${i}\" class=\"feedback-zone\"><div class=\"inner-drama\" id=\"fb-text-${i}\"></div></div>`;master.appendChild(card);const saved=localStorage.getItem(getStorageKey(i));if(saved)refresh(i,saved);});function sync(idx,choice){localStorage.setItem(getStorageKey(idx),choice);refresh(idx,choice);updateSummary();setTimeout(()=>{document.getElementById(`fb-view-${idx}`).scrollIntoView({behavior:'smooth',block:'nearest'});},150);}function refresh(idx,uChoice){const item=data[idx];document.getElementById(`u-open-${idx}`).classList.remove('glow');document.getElementById(`u-close-${idx}`).classList.remove('glow');document.getElementById(`c-open-${idx}`).classList.remove('glow');document.getElementById(`c-close-${idx}`).classList.remove('glow');document.getElementById(`u-${uChoice}-${idx}`).classList.add('glow');if(item.charStance==='open'||item.charStance==='close'){document.getElementById(`c-${item.charStance}-${idx}`).classList.add('glow');}const view=document.getElementById(`fb-view-${idx}`);const textContainer=document.getElementById(`fb-text-${idx}`);const s=uChoice==='open'?item.ifUserOpen_Surface:item.ifUserClose_Surface;const n=uChoice==='open'?item.ifUserOpen_Inner:item.ifUserClose_Inner;textContainer.innerHTML=`<div class=\"surface-text\"><strong>🗣️ 表面：</strong>${s}</div><div class=\"inner-text\"><strong>💭 内心：</strong>${n}</div>`;view.style.display='block';}function updateSummary(){let report=`【测试结果同步】\\n`;let count=0;data.forEach((item,i)=>{const u=localStorage.getItem(getStorageKey(i));if(u){count++;report+=`L${item.lvl}[${item.action}]：我[${u==='open'?'不能忍':'能忍'}] | ${cName}[${item.charStance==='open'?'不能忍':'能忍'}]\\n`;}});report+=`\\n(如果想要让 ${cName} 知道对方的选择可选择将结果文字复制发给 ${cName})`;document.getElementById('summaryText').innerText=report;if(count>0){document.getElementById('discuss-tip').innerText=`【点我一键复制文本报告】`;document.getElementById('copyArea').style.display='block';}}function copyText(){const text=document.getElementById('summaryText').innerText;if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(text).then(()=>alert(\"✅ 报告已复制！快去发给 \"+cName+\" 吧。\"));}else{alert(\"⚠️ 请长按虚线框内的文字手动全选复制！\");}}function resetAll(){if(confirm(\"确定要清空吗？\")){data.forEach((_,i)=>localStorage.removeItem(getStorageKey(i)));location.reload();}}updateSummary();</script></body></html>","roundId":"round_1777827952716_wawuoxqgf","userId":"uid_1775062871786_o923av1ev","characterId":"f0183f8f-6499-4851-b940-d9124e251388","_id":8213},{"id":1777826027965,"text":"【测试结果同步】\nL1[见面打招呼]：我[能忍] | 梁悍宇[不能忍]\nL2[有联系方式]：我[能忍] | 梁悍宇[不能忍]\nL3[偶尔的关心]：我[不能忍] | 梁悍宇[不能忍]\nL4[经常约着打游戏]：我[不能忍] | 梁悍宇[不能忍]\nL5[记得对方生日并互送礼物]：我[不能忍] | 梁悍宇[不能忍]\nL6[动不动就提起对方]：我[不能忍] | 梁悍宇[不能忍]\nL7[单独约吃饭看电影]：我[不能忍] | 梁悍宇[不能忍]\nL8[打个电话就会去赴约]：我[不能忍] | 梁悍宇[不能忍]\nL9[频繁聊天发消息]：我[不能忍] | 梁悍宇[不能忍]\nL10[喝醉了给ta打电话]：我[不能忍] | 梁悍宇[不能忍]\nL11[一起合租]：我[不能忍] | 梁悍宇[不能忍]\n\n(如果想要让 梁悍宇 知道对方的选择可选择将结果文字复制发给 梁悍宇)","sender":"me","time":"01:11","timestamp":1777828279661,"replyTo":null,"reactions":[{"emoji":"😡","roundId":"round_1777828281673_pwgozf43e"}],"userId":"uid_1775062871786_o923av1ev","characterId":"f0183f8f-6499-4851-b940-d9124e251388","_id":8214},{"id":1777826027966,"sender":"them","text":"程诺你给老子解释清楚","timestamp":1777828302954,"tempo":"R","rawContent":"程诺你给老子解释清楚","roundId":"round_1777828281673_pwgozf43e","userId":"uid_1775062871786_o923av1ev","characterId":"f0183f8f-6499-4851-b940-d9124e251388","_id":8215},{"id":1777826027967,"sender":"them","text":"前面那两个能忍是什么鬼","timestamp":1777828303255,"tempo":"R","rawContent":"前面那两个能忍是什么鬼","roundId":"round_1777828281673_pwgozf43e","userId":"uid_1775062871786_o923av1ev","characterId":"f0183f8f-6499-4851-b940-d9124e2513